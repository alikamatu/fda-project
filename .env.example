# =============================================================================
# FDA Monorepo - Environment Configurations Guide
# =============================================================================
#
# This repository is composed of three applications:
# 1. apps/api     - NestJS Backend (Database, Authentication, Business Logic)
# 2. apps/web     - Next.js Web Dashboard & Portal
# 3. apps/mobile  - Expo / React Native Mobile Verifier
#
# Copy each relevant .env.example to .env in each corresponding app directory:
#   apps/api/.env.example    -> apps/api/.env
#   apps/web/.env.example    -> apps/web/.env
#   apps/mobile/.env.example -> apps/mobile/.env
#
# -----------------------------------------------------------------------------
# 1. API Service (apps/api/.env)
# -----------------------------------------------------------------------------
# PORT=1000
# NODE_ENV=development
# FRONTEND_URL=http://localhost:3000
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fda_dev?schema=public"
# DATABASE_SSL=false
# JWT_SECRET=fda_super_secret_jwt_key_2026_change_in_production
# JWT_EXPIRES_IN=7d
# BCRYPT_SALT_ROUNDS=10
#
# -----------------------------------------------------------------------------
# 2. Web Application (apps/web/.env)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:1000
# PORT=3000
#
# -----------------------------------------------------------------------------
# 3. Mobile App (apps/mobile/.env)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL=http://localhost:1000
# (For physical device testing, set to machine LAN IP: e.g. http://192.168.1.X:1000)
#
# =============================================================================
