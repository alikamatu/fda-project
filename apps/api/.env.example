# =============================================================================
# FDA System API - Environment Variables Template
# =============================================================================

# Server Port and Environment
PORT=1000
NODE_ENV=development

# Frontend Application Origin (for CORS)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection URL
# Local Docker (docker-compose.dev.yml) or local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fda_dev?schema=public"

# Remote PostgreSQL Example (Supabase / AWS RDS / Neon):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?schema=public"

# Database SSL Mode:
# Set to 'false' for local PostgreSQL / Docker (no SSL support)
# Set to 'true' for remote managed PostgreSQL (e.g. Supabase, AWS RDS, Neon)
DATABASE_SSL=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=10
