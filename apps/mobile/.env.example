# =============================================================================
# FDA System Mobile (Expo / React Native) - Environment Variables Template
# =============================================================================

# Backend API URL (prefixed with EXPO_PUBLIC_ for Expo SDK)
#
# Choose the appropriate URL based on your development environment:
# - Web Preview / iOS Simulator: http://localhost:1000
# - Android Emulator: http://10.0.2.2:1000
# - Physical Mobile Device: http://<YOUR_COMPUTER_LOCAL_IP>:1000 (e.g., http://192.168.100.223:1000 or http://20.20.3.116:1000)
#
EXPO_PUBLIC_API_URL=http://localhost:1000
